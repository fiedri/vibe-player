{
	"name": "Vibe",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
    "dev:android": "CAP_ENV=dev npx cap sync android && CAP_ENV=dev npx cap run android",
		"sync:dev": "CAP_ENV=dev npx cap sync android",
		"build:android": "pnpm build && npx cap sync android"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@fontsource-variable/inter": "^5.3.0",
		"@libsql/client": "latest",
		"@sveltejs/adapter-auto": "latest",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"clsx": "^2.1.1",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"shadcn-svelte": "^1.4.2",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@capacitor-community/media": "^9.1.0",
		"@capacitor-community/sqlite": "^8.1.0",
		"@capacitor/android": "^8.4.2",
		"@capacitor/app": "^8.1.1",
		"@capacitor/cli": "^8.4.2",
		"@capacitor/core": "^8.4.2",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/local-notifications": "^8.2.1",
		"@capacitor/preferences": "^8.0.1",
		"@capgo/capacitor-media-session": "^8.0.29",
		"@odion-cloud/capacitor-mediastore": "^1.0.21",
		"carbon-icons-svelte": "^13.13.0"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.33.5"
		},
		"onlyBuiltDependencies": [
			"sharp"
		],
		"patchedDependencies": {
			"@capgo/capacitor-media-session": "patches/@capgo__capacitor-media-session.patch",
			"@odion-cloud/capacitor-mediastore": "patches/@odion-cloud__capacitor-mediastore.patch"
		}
	}
}
