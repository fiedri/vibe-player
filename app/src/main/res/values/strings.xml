    <string name="info_page_title">Instructions</string>
    <string name="info_page_intro_before">Vibe uses a</string>
    <string name="info_page_foreground_service">foreground service</string>
    <string name="info_page_intro_after">so the music keeps playing even when you leave the app in the background. On stock Android this works without you having to touch anything. However, some brands —Xiaomi, Samsung, OnePlus, Huawei— ship with such aggressive battery optimizers that they can kill Vibe. Here we show you how to allow it on each one.</string>
    <string name="info_page_generic_title">Generic Android</string>
    <string name="info_page_generic_step_1_before">Settings → Apps → Vibe → Battery → select</string>
    <string name="info_page_generic_step_1_option">\"Unrestricted\"</string>
    <string name="info_page_generic_step_1_after">(or \"Don\'t optimize\").</string>
    <string name="info_page_generic_step_2">Alternative: Settings → Battery → Battery optimization → find Vibe and disable optimization.</string>
    <string name="info_page_xiaomi_title">Xiaomi / MIUI / HyperOS</string>
    <string name="info_page_xiaomi_step_1">Settings → Apps → App permissions → Autostart in background → allow Vibe.</string>
    <string name="info_page_xiaomi_step_2_before">Settings → Battery → select</string>
    <string name="info_page_xiaomi_step_2_option">\"Unrestricted\"</string>
    <string name="info_page_xiaomi_step_2_after">for Vibe.</string>
    <string name="info_page_xiaomi_step_3_before">In Developer options → disable the</string>
    <string name="info_page_xiaomi_step_3_option">\"MIUI optimization\"</string>
    <string name="info_page_xiaomi_step_3_after">.</string>
    <string name="info_page_samsung_title">Samsung (One UI)</string>
    <string name="info_page_samsung_step_1">Settings → Battery → Background usage limits → Apps that never sleep → add Vibe.</string>
    <string name="info_page_oneplus_title">OnePlus / OPPO (ColorOS)</string>
    <string name="info_page_oneplus_step_1_before">Settings → Battery → disable</string>
    <string name="info_page_oneplus_step_1_option_a">\"Adaptive battery\"</string>
    <string name="info_page_oneplus_step_1_middle">and/or</string>
    <string name="info_page_oneplus_step_1_option_b">\"Deep optimization\"</string>
    <string name="info_page_oneplus_step_1_after">.</string>
    <string name="info_page_oneplus_step_2">Enable Vibe\'s Auto-start.</string>
    <string name="info_page_oneplus_step_3">Pin Vibe in multitasking: open Recents and lock the Vibe card (press and hold it and tap the padlock).</string>
    <string name="info_page_huawei_title">Huawei (EMUI / HarmonyOS)</string>
    <string name="info_page_huawei_step_1">Settings → Battery → App launch → Manage manually → allow Vibe (enable \"Allow auto-launch\", \"Allow secondary launch\", and \"Allow background activity\").</string>
    <string name="info_page_warning">On OnePlus and other brands, the configuration can be reset with system updates. If Vibe stops playing in the background, go back and check these steps.</string>
