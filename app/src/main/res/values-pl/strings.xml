    <string name="info_page_title">Instrukcje</string>
    <string name="info_page_intro_before">Vibe korzysta z</string>
    <string name="info_page_foreground_service">usługi pierwszoplanowej</string>
    <string name="info_page_intro_after">– dzięki niej muzyka gra dalej, nawet gdy aplikacja działa w tle. Na czystym Androidzie działa to bez żadnej konfiguracji. Niektórzy producenci – Xiaomi, Samsung, OnePlus, Huawei – stosują jednak tak agresywne oszczędzanie baterii, że potrafią zamknąć Vibe. Poniżej pokazujemy, jak na to zezwolić na każdym z nich.</string>
    <string name="info_page_generic_title">Android (ogólnie)</string>
    <string name="info_page_generic_step_1_before">Ustawienia → Aplikacje → Vibe → Bateria → wybierz</string>
    <string name="info_page_generic_step_1_option">„Bez ograniczeń”</string>
    <string name="info_page_generic_step_1_after">(lub „Nie optymalizuj”).</string>
    <string name="info_page_generic_step_2">Alternatywnie: Ustawienia → Bateria → Optymalizacja baterii → znajdź Vibe i wyłącz optymalizację.</string>
    <string name="info_page_xiaomi_title">Xiaomi / MIUI / HyperOS</string>
    <string name="info_page_xiaomi_step_1">Ustawienia → Aplikacje → Uprawnienia → Autostart → zezwól aplikacji Vibe.</string>
    <string name="info_page_xiaomi_step_2_before">Ustawienia → Bateria → wybierz</string>
    <string name="info_page_xiaomi_step_2_option">„Bez ograniczeń”</string>
    <string name="info_page_xiaomi_step_2_after">dla Vibe.</string>
    <string name="info_page_xiaomi_step_3_before">W Opcjach programisty → wyłącz</string>
    <string name="info_page_xiaomi_step_3_option">„Optymalizację MIUI”</string>
    <string name="info_page_xiaomi_step_3_after">.</string>
    <string name="info_page_samsung_title">Samsung (One UI)</string>
    <string name="info_page_samsung_step_1">Ustawienia → Bateria → Limity użycia w tle → Aplikacje nigdy nieusypiane → dodaj Vibe.</string>
    <string name="info_page_oneplus_title">OnePlus / OPPO (ColorOS)</string>
    <string name="info_page_oneplus_step_1_before">Ustawienia → Bateria → wyłącz</string>
    <string name="info_page_oneplus_step_1_option_a">„Baterię adaptacyjną”</string>
    <string name="info_page_oneplus_step_1_middle">i/lub</string>
    <string name="info_page_oneplus_step_1_option_b">„Głęboką optymalizację”</string>
    <string name="info_page_oneplus_step_1_after">.</string>
    <string name="info_page_oneplus_step_2">Włącz autostart dla Vibe.</string>
    <string name="info_page_oneplus_step_3">Przypnij Vibe w ostatnich aplikacjach: otwórz ekran ostatnich aplikacji i zablokuj kartę Vibe (przytrzymaj ją i dotknij kłódki).</string>
    <string name="info_page_huawei_title">Huawei (EMUI / HarmonyOS)</string>
    <string name="info_page_huawei_step_1">Ustawienia → Bateria → Uruchamianie aplikacji → Zarządzaj ręcznie → zezwól aplikacji Vibe (włącz „Automatyczne uruchamianie”, „Uruchamianie pośrednie” i „Działanie w tle”).</string>
    <string name="info_page_warning">Na OnePlusach i urządzeniach innych marek aktualizacje systemu mogą przywrócić te ustawienia. Jeśli Vibe przestanie grać w tle, sprawdź te kroki ponownie.</string>
