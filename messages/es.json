  "info_page": {
    "title": "Instrucciones",
    "intro_before": "Vibe usa un",
    "foreground_service": "servicio en primer plano",
    "intro_after": "para que la música siga sonando aunque dejes la app en segundo plano. En Android stock esto funciona sin que tengas que tocar nada. Sin embargo, algunas marcas —Xiaomi, Samsung, OnePlus, Huawei— traen optimizadores de batería tan agresivos que pueden cerrar Vibe. Acá te mostramos cómo permitirla en cada una.",
    "generic": {
      "title": "Android genérico",
      "step_1_before": "Ajustes → Apps → Vibe → Batería → seleccioná",
      "step_1_option": "\"Sin restricciones\"",
      "step_1_after": "(o \"No optimizar\").",
      "step_2": "Alternativa: Ajustes → Batería → Optimización de batería → buscá Vibe y desactivá la optimización."
    },
    "xiaomi": {
      "title": "Xiaomi / MIUI / HyperOS",
      "step_1": "Ajustes → Apps → Permisos de apps → Inicio automático en segundo plano → permití Vibe.",
      "step_2_before": "Ajustes → Batería → seleccioná",
      "step_2_option": "\"Sin restricciones\"",
      "step_2_after": "para Vibe.",
      "step_3_before": "En Opciones de desarrollador → desactivá la",
      "step_3_option": "\"Optimización MIUI\"",
      "step_3_after": "."
    },
    "samsung": {
      "title": "Samsung (One UI)",
      "step_1": "Ajustes → Batería → Límites de uso en segundo plano → Apps que nunca duermen → agregá Vibe."
    },
    "oneplus": {
      "title": "OnePlus / OPPO (ColorOS)",
      "step_1_before": "Ajustes → Batería → desactivá",
      "step_1_option_a": "\"Batería adaptable\"",
      "step_1_middle": "y/o",
      "step_1_option_b": "\"Optimización profunda\"",
      "step_1_after": ".",
      "step_2": "Habilitá el Auto-inicio de Vibe.",
      "step_3": "Fijá Vibe en el multitarea: abrí los Recents y bloqueá la tarjeta de Vibe (mantenela presionada y tocá el candado)."
    },
    "huawei": {
      "title": "Huawei (EMUI / HarmonyOS)",
      "step_1": "Ajustes → Batería → Inicio de apps → Administrar manualmente → permití Vibe (activá \"Permitir inicio automático\", \"Permitir actividad en segundo plano\" y \"Permitir ejecución en segundo plano\")."
    },
    "warning": "En OnePlus y otras marcas, la configuración puede revertirse con las actualizaciones del sistema. Si Vibe deja de sonar en segundo plano, volvé a revisar estos pasos."
  },
