  "info_page": {
    "title": "Instructions",
    "intro_before": "Vibe uses a",
    "foreground_service": "foreground service",
    "intro_after": "so the music keeps playing even when you leave the app in the background. On stock Android this works without you having to touch anything. However, some brands —Xiaomi, Samsung, OnePlus, Huawei— ship with such aggressive battery optimizers that they can kill Vibe. Here we show you how to allow it on each one.",
    "generic": {
      "title": "Generic Android",
      "step_1_before": "Settings → Apps → Vibe → Battery → select",
      "step_1_option": "\"Unrestricted\"",
      "step_1_after": "(or \"Don't optimize\").",
      "step_2": "Alternative: Settings → Battery → Battery optimization → find Vibe and disable optimization."
    },
    "xiaomi": {
      "title": "Xiaomi / MIUI / HyperOS",
      "step_1": "Settings → Apps → App permissions → Autostart in background → allow Vibe.",
      "step_2_before": "Settings → Battery → select",
      "step_2_option": "\"Unrestricted\"",
      "step_2_after": "for Vibe.",
      "step_3_before": "In Developer options → disable the",
      "step_3_option": "\"MIUI optimization\"",
      "step_3_after": "."
    },
    "samsung": {
      "title": "Samsung (One UI)",
      "step_1": "Settings → Battery → Background usage limits → Apps that never sleep → add Vibe."
    },
    "oneplus": {
      "title": "OnePlus / OPPO (ColorOS)",
      "step_1_before": "Settings → Battery → disable",
      "step_1_option_a": "\"Adaptive battery\"",
      "step_1_middle": "and/or",
      "step_1_option_b": "\"Deep optimization\"",
      "step_1_after": ".",
      "step_2": "Enable Vibe's Auto-start.",
      "step_3": "Pin Vibe in multitasking: open Recents and lock the Vibe card (press and hold it and tap the padlock)."
    },
    "huawei": {
      "title": "Huawei (EMUI / HarmonyOS)",
      "step_1": "Settings → Battery → App launch → Manage manually → allow Vibe (enable \"Allow auto-launch\", \"Allow secondary launch\", and \"Allow background activity\")."
    },
    "warning": "On OnePlus and other brands, the configuration can be reset with system updates. If Vibe stops playing in the background, go back and check these steps."
  },
  "settings": {
    "general": "General Settings",
    "language": "Language",
    "language_auto": "Auto (system)"
  }
